    "test:report": "playwright show-report",
    "shots": "playwright test -g \"full-page screenshot\"",
    "test:responsive": "playwright test tests/responsive.spec.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "live-server": "^1.2.2"
  }
}
